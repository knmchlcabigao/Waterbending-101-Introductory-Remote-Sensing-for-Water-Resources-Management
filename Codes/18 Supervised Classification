//   bands: ['B4','B3','B2']
// });


// Combine training data
var trainingPts = urban.merge(water).merge(vegetation);

// divide training points into training and validation
var trainingPts = trainingPts.randomColumn();
var trainingGcp = trainingPts.filter(ee.Filter.lt('random', 0.7));
var validationGcp = trainingPts.filter(ee.Filter.gte('random', 0.7));

// Overlay the points on the image to get training data
var training = filtered_data.sampleRegions({
  collection: trainingGcp, 
  properties: ['landcover'],
  scale: 10
});

// Get bands for analysis and classification
var classifier = ee.Classifier.smileRandomForest(50).train({
  features: training, 
  classProperty: 'landcover',
  inputProperties: filtered_data.bandNames()
});

//Classify the image using the trained model
var classified = filtered_data.classify(classifier);

// Visualize results
var palette = ['red','blue','green'];

Map.addLayer(classified, {min: 1, max: 3, palette: palette}, 'Classified Image');

// Accuracy assessment
var test = classified.sampleRegions({
  collection: validationGcp,
  properties: ['landcover'],
  scale: 10
});

var testConfusionMatrix = test.errorMatrix('landcover', 'classification');
print('Confusion Matrix', testConfusionMatrix);
print('Test accuracy', testConfusionMatrix.accuracy());


// export confusion matrix

var errorMatrixResults = ee.FeatureCollection([
  ee.Feature(null, {
    'accuracy': testConfusionMatrix.accuracy(),
    'consumer accuracy': testConfusionMatrix.consumersAccuracy(),
    'producer accuracy': testConfusionMatrix.producersAccuracy(),
    'Kappa': testConfusionMatrix.kappa()
  })
]);
  
Export.table.toDrive({
  collection: errorMatrixResults,
  description: 'Confusion_matrix',
  fileFormat: 'CSV'
});
