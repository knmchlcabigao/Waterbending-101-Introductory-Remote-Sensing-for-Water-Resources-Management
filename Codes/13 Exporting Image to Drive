// Importing Landsat Images
var landsat = ee.ImageCollection("LANDSAT/LC08/C02/T1_L2");

// Cloud Masking Landsat 8 Surface Reflectance Data

function maskL8sr(image) {
  // Bit 0 - Fill
  // Bit 1 - Dilated Cloud
  // Bit 2 - Cirrus
  // Bit 3 - Cloud
  // Bit 4 - Cloud Shadow
  var qaMask = image.select('QA_PIXEL').bitwiseAnd(parseInt('11111', 2)).eq(0);
  var saturationMask = image.select('QA_RADSAT').eq(0);

  // Apply the scaling factors to the appropriate bands.
  var opticalBands = image.select('SR_B.').multiply(0.0000275).add(-0.2);
  var thermalBands = image.select('ST_B.*').multiply(0.00341802).add(149.0);

  // Replace the original bands with the scaled ones and apply the masks.
  return image.addBands(opticalBands, null, true)
      .addBands(thermalBands, null, true)
      .updateMask(qaMask)
      .updateMask(saturationMask);
}

// Apply filters, reducers, scaling factors, and cloud masking
var filtered_data = landsat.filterBounds(roi)
.filterDate('2018-01-01', '2019-12-31')
.filterMetadata('CLOUD_COVER', 'less_than', 30)
.map(maskL8sr)
.median()
.clip(roi);

// Visualization Parameters
var rgb_Viz = {
  min: 0, 
  max: 0.3,
  bands: ['SR_B4', 'SR_B3', 'SR_B2']
};

// Visualize

Map.addLayer(filtered_data, rgb_Viz, 'True Color Composite');
Map.centerObject(roi,10);

// Computing Indices
var mndwi = filtered_data.normalizedDifference(['SR_B3','SR_B6']);

// Visualize MNDWI (normalized difference output ranges from -1 to +1)

var mndwi_viz = {
  min: -1,
  max: 1,
  palette: ['red','white','blue']
};

Map.addLayer(mndwi, mndwi_viz, "2018 MNDWI");
Map.centerObject(roi);

// Exporting image to drive
var mndwi_drive = Export.image.toDrive({
  image: mndwi,
  description: '2018_MNDWI', 
  folder: "Remote Sensing", 
  region: roi, 
  scale: 60,
  maxPixels: 1e13
});
