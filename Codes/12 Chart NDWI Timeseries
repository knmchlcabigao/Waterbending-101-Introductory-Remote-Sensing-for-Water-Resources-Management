// Importing Landsat Images
var landsat = ee.ImageCollection("LANDSAT/LC08/C02/T1_L2");

// Cloud Masking Landsat 8 Surface Reflectance Data

function maskL8sr(image) {
  // Bit 0 - Fill
  // Bit 1 - Dilated Cloud
  // Bit 2 - Cirrus
  // Bit 3 - Cloud
  // Bit 4 - Cloud Shadow
  var qaMask = image.select('QA_PIXEL').bitwiseAnd(parseInt('11111', 2)).eq(0);
  var saturationMask = image.select('QA_RADSAT').eq(0);

  // Apply the scaling factors to the appropriate bands.
  var opticalBands = image.select('SR_B.').multiply(0.0000275).add(-0.2);
  var thermalBands = image.select('ST_B.*').multiply(0.00341802).add(149.0);

  // Replace the original bands with the scaled ones and apply the masks.
  return image.addBands(opticalBands, null, true)
      .addBands(thermalBands, null, true)
      .updateMask(qaMask)
      .updateMask(saturationMask);
}

// Computing NDWI to each image in the collection
function computeNDWI(image){
  var ndwi = image.normalizedDifference(['SR_B6','SR_B5']).rename('NDWI');
  return image.addBands(ndwi);
}

// Apply filters, reducers, scaling factors, cloud masking, and spectral index computation
var filtered_data = landsat.filterBounds(roi)
.filterDate('2018-01-01', '2019-12-31')
.filterMetadata('CLOUD_COVER', 'less_than', 30)
.map(maskL8sr)
.map(computeNDWI);

// preserve time stamp per image. Write a function to fix. 

function fixTime(image){
  return image.select('NDWI')
  .copyProperties(image, ['system:time_start']);
}

// Apply fixed timestamp to the final data collection

var final_data = filtered_data.map(fixTime);

// Creating an NDWI chart over time (Average for the whole ROI)

var NDWIchart = ui.Chart.image.series({
  imageCollection: final_data, 
  region: roi, 
  reducer: ee.Reducer.mean(), 
  scale: 60
}).setOptions({
  title: 'Mean NDWI over NCR',
  hAxis: {
    title: 'Date',
    format: 'YYYY-MM'
  },
  xAxis: {title: 'NDWI'}
});

print(NDWIchart);
