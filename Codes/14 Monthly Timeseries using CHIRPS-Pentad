// Aggregating monthly time series

// Get data

var chirps = ee.ImageCollection("UCSB-CHC/CHIRPS/V3/PENTAD");

// target year
var startYear = 2017;
var endYear = 2020;

// Create a list of months for 2017
var years = ee.List.sequence(startYear, endYear);
var months = ee.List.sequence(1,12);

// Checking functions if it will work
var monthly = function(year, month){
  year = ee.Number(year);
  month = ee.Number(month);
  
  var startDate = ee.Date.fromYMD(year, month,1);
  var endDate = startDate.advance(1,'month');
  
  return chirps.filterDate(startDate, endDate);
};

var result = years.map(function(year){
  return months.map(function(month){
    return monthly(year,month);
  });
});

print('Nested list:', result);
print('Flattended list:', result.flatten());


// Create a function that takes a month number and returns a monthly image through reducers (2017)
var createMonthlyImage = function(year, month){
  year = ee.Number(year);
  month = ee.Number(month);
  
  var startDate = ee.Date.fromYMD(year, month,1);
  var endDate = startDate.advance(1,'month');
  
  var monthlyCol = chirps.filterDate(startDate, endDate);
  var total = monthlyCol.reduce(ee.Reducer.sum());
  
  return total.set({
    'system:time_start': startDate.millis(),
    'system:time_end': endDate.millis(),
    'year': year,
    'month': month
  });
};

var monthlyImages = years.map(function(y){
  return months.map(function(m){
    return createMonthlyImage(y, m);
  });
}).flatten();


var monthlyCollection = ee.ImageCollection.fromImages(monthlyImages);

print('Monthly Collection (2017-2020)', monthlyCollection);


// chart monthly timeseries

var monthlyChart = ui.Chart.image.series({
  imageCollection: monthlyCollection,
  region: geom, 
  reducer: ee.Reducer.mean(),
  scale: 5566
  }).setOptions({
    linewidth: 1,
    pointSize: 3,
    title: 'Monthly Rainfall across NCR',
    vAxis: {title: 'Monthly Rainfall (mm)'},
    hAxis: {title: 'Date', gridlines: {count: 12}}
  });
  
print(monthlyChart);

// export per pixel timeseries
var tsOutput = monthlyCollection.map(function(img){
  var date = img.date().format('YYYY-MM');
  
  return img.sample({
    region: geom,
    scale: 5566, 
    geometries: true
  })
  .map(function(f){
    var coords = f.geometry().coordinates();
    
    return f.set({
      'station': f.id(),
      'lon': coords.get(0),
      'lat': coords.get(1),
      'date': date
    })
  });
}).flatten();

print(tsOutput);

