// Line comments start with two forward slashes. Like this line.

/* Multi line comments start with a forward slash and a star,
and end with a star and a forward slash. */

// Variables are used to store objects, and are defined using the keyword var.
var variable = 1;

// String objects start and end with a single quote.
var string_variable = 'I am a string';

// String objects can also start and end with double quotes.
// But don't mix and match them.
var string_variable_2 = "I am also a string";

// Statements should end in a semi-colon, or the editor complains.
var test = 'so semi-colon...'

// Parentheses are used to pass parameters to functions.
print('This string will print in the Console tab (Right panel).');

// Square brackets are used for selecting items within a list.  
// The zero index refers to the first item in the list.
var sphere_list = ['Hydrosphere', 'Atmosphere', 'Geosphere', 'Biosphere'];
print(sphere_list[0]);

// Curly brackets (or braces) can be used to define dictionaries
// (key:value pairs).
var sphere_dictionary = {'Hydrosphere':'E-Hydro Lab', 'Atmosphere':'Bagtasa Lab', 
                          'Geosphere': 'EarthsMAP', 'Biosphere': 'MMRCL'};

// Square brackets can be used to access dictionary items by key.
print(sphere_dictionary['Hydrosphere']);

//Or you can use the dot notation to get the same result.
print(sphere_dictionary.Hydrosphere);

// Functions can be defined as a way to reuse code and make it easier to read.
var hello_world_function = function(string) {
  return 'Hello ' + string + '!';
};
print(hello_world_function('world'));
